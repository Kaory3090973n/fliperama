<!DOCTYPE html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Rei da Pradaria</title><link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet"><style>html,body{margin:0;height:100%;background:#000;overflow:hidden;display:grid;place-items:center}canvas{image-rendering:pixelated;background:#111}</style></head><body><canvas id="c"></canvas><script>
/* ===== base comum dos jogos do fliperama: tela 640x370, teclado (WASD + I J K L / setas), pausa, SAIR e avisos ao fliperama ===== */
const cv=document.getElementById('c'),g=cv.getContext('2d'),W=640,H=370;cv.width=W;cv.height=H;
const fit=()=>{const s=Math.min(innerWidth/W,innerHeight/H);cv.style.width=W*s+'px';cv.style.height=H*s+'px'};addEventListener('resize',fit);fit();
const K={},par=parent!==window,F="'Press Start 2P',monospace";let S='title',T=0,sc=0,pm=0,HI=0,OM='',AC;
const fp=(k,d)=>{if(par)try{parent.postMessage({fliperama:'tecla',k,d},'*')}catch(_){}};
const rc=(x,y,w,h,c)=>{g.fillStyle=c;g.fillRect(Math.round(x),Math.round(y),Math.round(w),Math.round(h))};
const tx=(s,x,y,z,c,a)=>{g.font=z+'px '+F;g.textAlign=a||'left';g.textBaseline='middle';g.fillStyle='#000';g.fillText(s,x+1,y+1);g.fillStyle=c||'#fff';g.fillText(s,x,y)};
const bp=(f,d,v,t)=>{try{AC=AC||new AudioContext();const o=AC.createOscillator(),n=AC.createGain(),a=AC.currentTime;o.type=t||'square';o.frequency.value=f;n.gain.setValueAtTime(v||.04,a);n.gain.exponentialRampToValueAtTime(.0001,a+d);o.connect(n);n.connect(AC.destination);o.start(a);o.stop(a+d)}catch(e){}};
const mv=()=>[(K.d||0)-(K.a||0),(K.s||0)-(K.w||0)],aim=()=>[(K.l||K.arrowright||0)-(K.j||K.arrowleft||0),(K.k||K.arrowdown||0)-(K.i||K.arrowup||0)],rnd=(a,b)=>a+Math.random()*(b-a),clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const back=()=>{try{(window.top||window).location.href='../../index.html'}catch(e){location.href='../../index.html'}};
const sair=()=>{if(par){try{parent.postMessage({fliperama:'sair'},'*')}catch(e){}setTimeout(back,900)}else back()};
function over(m){OM=m||'FIM DE JOGO';S='over';if(sc>HI){HI=sc;try{localStorage.setItem('hi:'+G.id,HI)}catch(e){}}bp(150,.5,.07,'sawtooth')}
const OK=k=>k==='enter'||k===' '||k==='j';
function kd(k){
 if(S==='title'){if(OK(k)){S='play';G.init();bp(660,.1)}else if(k==='escape')sair()}
 else if(S==='play'){if(k==='escape'||k==='p'){S='pause';pm=0}else if(G.key)G.key(k)}
 else if(S==='pause'){if(k==='w'||k==='s'||k==='arrowup'||k==='arrowdown')pm^=1;else if(OK(k)){if(pm)sair();else S='play'}else if(k==='escape')S='play'}
 else if(S==='over'){if(OK(k)){S='play';G.init();bp(660,.1)}else if(k==='escape')sair()}}
addEventListener('keydown',e=>{const k=e.key.toLowerCase();if(!e.repeat){K[k]=1;fp(k,1);kd(k)}if(k.startsWith('arrow')||k===' ')e.preventDefault()});
addEventListener('keyup',e=>{const k=e.key.toLowerCase();K[k]=0;fp(k,0)});addEventListener('blur',()=>{for(const k in K)K[k]=0;fp('*',0)});
let L=0;function loop(n){requestAnimationFrame(loop);const dt=Math.min(.05,(n-L)/1e3||0);L=n;T+=dt;g.imageSmoothingEnabled=false;
 if(S==='play')G.update(dt);G.draw();
 if(S!=='play'){rc(0,0,W,H,'rgba(0,0,0,.66)');const b=Math.floor(T*2)%2;
  if(S==='title'){tx(G.title,W/2,100,G.title.length>12?24:30,G.col,'center');G.sub.forEach((s,i)=>tx(s,W/2,160+i*18,9,'#cfd6e6','center'));if(b)tx('APERTE J OU ENTER',W/2,250,12,'#fff','center');tx('ESC: SAIR',W/2,330,8,'#8793b8','center');if(HI)tx('RECORDE '+HI,W/2,290,9,'#ffd23a','center')}
  else if(S==='pause'){tx('PAUSA',W/2,120,24,'#fff','center');['CONTINUAR','SAIR'].forEach((s,i)=>tx((pm===i?'> ':'')+s,W/2,190+i*34,14,pm===i?'#ffd23a':'#8793b8','center'))}
  else{tx(OM,W/2,110,24,G.col,'center');tx('PONTOS '+sc,W/2,170,14,'#fff','center');tx('RECORDE '+HI,W/2,200,10,'#ffd23a','center');if(b)tx('J: JOGAR DE NOVO',W/2,260,11,'#fff','center');tx('ESC: SAIR',W/2,300,9,'#8793b8','center')}}}
const AX=144,AY=9,N=352;
const G={id:'pradaria',title:'REI DA PRADARIA',col:'#e8b04a',sub:['WASD: ANDAR','I J K L OU SETAS: ATIRAR','PEGUE OS ITENS QUE CAEM'],
init(){sc=0;this.p={x:176,y:176,fr:0};this.b=[];this.e=[];this.d=[];this.lv=1;this.tm=40;this.sp=1;this.lives=3;this.inv=0;this.pw={s:0,m:0,r:0};this.msg=2},
update(dt){const p=this.p,[mx,my]=mv(),[ax,ay]=aim(),d=mx&&my?.707:1,sp=75+(this.pw.s>0?45:0);
 p.x=clamp(p.x+mx*sp*dt*d,8,N-8);p.y=clamp(p.y+my*sp*dt*d,8,N-8);
 for(const k in this.pw)if(this.pw[k]>0)this.pw[k]-=dt;
 this.inv-=dt;this.msg-=dt;p.fr-=dt;
 if((ax||ay)&&p.fr<=0){p.fr=this.pw.r>0?.1:.26;const a=Math.atan2(ay,ax);(this.pw.m>0?[-.3,0,.3]:[0]).forEach(o=>this.b.push({x:p.x,y:p.y,vx:Math.cos(a+o)*240,vy:Math.sin(a+o)*240}));bp(520,.04,.025)}
 this.sp-=dt;if(this.sp<=0){this.sp=Math.max(.22,1.05-this.lv*.1);const s=Math.random()*4|0,u=Math.random()*N;this.e.push({x:s<2?(s?N:0):u,y:s>1?(s>2?N:0):u,hp:this.lv>2&&Math.random()<.3?2:1})}
 this.tm-=dt;if(this.tm<=0){this.lv++;this.tm=40;this.e=[];this.msg=2;bp(880,.3,.05)}
 for(const b of this.b){b.x+=b.vx*dt;b.y+=b.vy*dt}this.b=this.b.filter(b=>b.x>0&&b.x<N&&b.y>0&&b.y<N);
 for(const e of this.e){const a=Math.atan2(p.y-e.y,p.x-e.x),v=26+this.lv*3+(e.hp>1?-6:0);e.x+=Math.cos(a)*v*dt;e.y+=Math.sin(a)*v*dt;
  for(const b of this.b)if(!b.x0&&Math.hypot(b.x-e.x,b.y-e.y)<9){b.x0=1;b.x=-99;e.hp--;if(e.hp<=0){e.dead=1;sc+=10;bp(200,.08,.04,'sawtooth');if(Math.random()<.14)this.d.push({x:e.x,y:e.y,t:'smrn'[Math.random()*4|0],l:9})}}
  if(!e.dead&&this.inv<=0&&Math.hypot(p.x-e.x,p.y-e.y)<10){this.lives--;this.inv=2;this.e=[];p.x=p.y=176;bp(110,.4,.07,'sawtooth');if(this.lives<=0){over();return}break}}
 this.e=this.e.filter(e=>!e.dead);this.b=this.b.filter(b=>b.x>0);
 for(const q of this.d){q.l-=dt;if(Math.hypot(p.x-q.x,p.y-q.y)<12){q.l=0;bp(900,.15,.05);if(q.t==='n'){sc+=10*this.e.length;this.e=[]}else this.pw[q.t]=9;}}this.d=this.d.filter(q=>q.l>0)},
draw(){rc(0,0,W,H,'#2a1a10');for(let y=0;y<16;y++)for(let x=0;x<16;x++)rc(AX+x*22,AY+y*22,22,22,(x+y)%2?'#5a8f3c':'#528535');
 rc(AX-3,AY-3,N+6,3,'#2a1a10');
 for(const q of this.d){const c={s:'#4de3ff',m:'#e8b04a',r:'#ff5a4a',n:'#fff'}[q.t];rc(AX+q.x-6,AY+q.y-6,12,12,'#000');rc(AX+q.x-5,AY+q.y-5,10,10,c);tx(q.t==='n'?'*':q.t.toUpperCase(),AX+q.x,AY+q.y+1,6,'#000','center')}
 for(const e of this.e){rc(AX+e.x-6,AY+e.y-6,12,12,e.hp>1?'#6b3a1a':'#3f9a3a');rc(AX+e.x-4,AY+e.y-3,3,3,'#fff');rc(AX+e.x+1,AY+e.y-3,3,3,'#fff');rc(AX+e.x-3,AY+e.y-2,1,1,'#000');rc(AX+e.x+2,AY+e.y-2,1,1,'#000')}
 for(const b of this.b)rc(AX+b.x-2,AY+b.y-2,4,4,'#fff3b0');
 const p=this.p;if(this.inv<=0||Math.floor(T*12)%2){rc(AX+p.x-7,AY+p.y-9,14,5,'#6b3a1a');rc(AX+p.x-4,AY+p.y-13,8,5,'#6b3a1a');rc(AX+p.x-5,AY+p.y-5,10,8,'#f1c27d');rc(AX+p.x-5,AY+p.y+3,10,7,'#3b6ed0');rc(AX+p.x-3,AY+p.y-3,2,2,'#000');rc(AX+p.x+1,AY+p.y-3,2,2,'#000')}
 rc(10,10,110,60,'#1b1008');tx('VIDAS',18,24,8,'#e8b04a');for(let i=0;i<this.lives;i++)rc(18+i*18,40,12,12,'#d93829');
 tx('FASE '+this.lv,18,62,8,'#fff');tx('PONTOS',W-120,24,8,'#e8b04a');tx(String(sc),W-120,40,12,'#fff');
 rc(AX,AY+N+4,N,5,'#000');rc(AX,AY+N+4,N*this.tm/40,5,'#e8b04a');
 let y=90;for(const[k,c,n]of[['s','#4de3ff','VELOZ'],['m','#e8b04a','TRIPLO'],['r','#ff5a4a','RAPIDO']])if(this.pw[k]>0){tx(n,18,y,7,c);y+=14}
 if(this.msg>0)tx('FASE '+this.lv,W/2,H/2,24,'#fff','center')}};

try{HI=+localStorage.getItem('hi:'+G.id)||0}catch(e){}try{document.fonts.load("10px 'Press Start 2P'")}catch(e){}
G.init();requestAnimationFrame(loop);
</script></body></html>
