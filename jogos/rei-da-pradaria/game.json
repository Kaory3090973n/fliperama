<!DOCTYPE html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Brotato</title><link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet"><style>html,body{margin:0;height:100%;background:#000;overflow:hidden;display:grid;place-items:center}canvas{image-rendering:pixelated;background:#111}</style></head><body><canvas id="c"></canvas><script>
/* ===== base comum dos jogos do fliperama: tela 640x370, teclado (WASD + I J K L / setas), pausa, SAIR e avisos ao fliperama ===== */
const cv=document.getElementById('c'),g=cv.getContext('2d'),W=640,H=370;cv.width=W;cv.height=H;
const fit=()=>{const s=Math.min(innerWidth/W,innerHeight/H);cv.style.width=W*s+'px';cv.style.height=H*s+'px'};addEventListener('resize',fit);fit();
const K={},par=parent!==window,F="'Press Start 2P',monospace";let S='title',T=0,sc=0,pm=0,HI=0,OM='',AC;
const fp=(k,d)=>{if(par)try{parent.postMessage({fliperama:'tecla',k,d},'*')}catch(_){}};
const rc=(x,y,w,h,c)=>{g.fillStyle=c;g.fillRect(Math.round(x),Math.round(y),Math.round(w),Math.round(h))};
const tx=(s,x,y,z,c,a)=>{g.font=z+'px '+F;g.textAlign=a||'left';g.textBaseline='middle';g.fillStyle='#000';g.fillText(s,x+1,y+1);g.fillStyle=c||'#fff';g.fillText(s,x,y)};
const bp=(f,d,v,t)=>{try{AC=AC||new AudioContext();const o=AC.createOscillator(),n=AC.createGain(),a=AC.currentTime;o.type=t||'square';o.frequency.value=f;n.gain.setValueAtTime(v||.04,a);n.gain.exponentialRampToValueAtTime(.0001,a+d);o.connect(n);n.connect(AC.destination);o.start(a);o.stop(a+d)}catch(e){}};
const mv=()=>[(K.d||0)-(K.a||0),(K.s||0)-(K.w||0)],aim=()=>[(K.l||K.arrowright||0)-(K.j||K.arrowleft||0),(K.k||K.arrowdown||0)-(K.i||K.arrowup||0)],rnd=(a,b)=>a+Math.random()*(b-a),clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const back=()=>{try{(window.top||window).location.href='../../index.html'}catch(e){location.href='../../index.html'}};
const sair=()=>{if(par){try{parent.postMessage({fliperama:'sair'},'*')}catch(e){}setTimeout(back,900)}else back()};
function over(m){OM=m||'FIM DE JOGO';S='over';if(sc>HI){HI=sc;try{localStorage.setItem('hi:'+G.id,HI)}catch(e){}}bp(150,.5,.07,'sawtooth')}
const OK=k=>k==='enter'||k===' '||k==='j';
function kd(k){
 if(S==='title'){if(OK(k)){S='play';G.init();bp(660,.1)}else if(k==='escape')sair()}
 else if(S==='play'){if(k==='escape'||k==='p'){S='pause';pm=0}else if(G.key)G.key(k)}
 else if(S==='pause'){if(k==='w'||k==='s'||k==='arrowup'||k==='arrowdown')pm^=1;else if(OK(k)){if(pm)sair();else S='play'}else if(k==='escape')S='play'}
 else if(S==='over'){if(OK(k)){S='play';G.init();bp(660,.1)}else if(k==='escape')sair()}}
addEventListener('keydown',e=>{const k=e.key.toLowerCase();if(!e.repeat){K[k]=1;fp(k,1);kd(k)}if(k.startsWith('arrow')||k===' ')e.preventDefault()});
addEventListener('keyup',e=>{const k=e.key.toLowerCase();K[k]=0;fp(k,0)});addEventListener('blur',()=>{for(const k in K)K[k]=0;fp('*',0)});
let L=0;function loop(n){requestAnimationFrame(loop);const dt=Math.min(.05,(n-L)/1e3||0);L=n;T+=dt;g.imageSmoothingEnabled=false;
 if(S==='play')G.update(dt);G.draw();
 if(S!=='play'){rc(0,0,W,H,'rgba(0,0,0,.66)');const b=Math.floor(T*2)%2;
  if(S==='title'){tx(G.title,W/2,100,G.title.length>12?24:30,G.col,'center');G.sub.forEach((s,i)=>tx(s,W/2,160+i*18,9,'#cfd6e6','center'));if(b)tx('APERTE J OU ENTER',W/2,250,12,'#fff','center');tx('ESC: SAIR',W/2,330,8,'#8793b8','center');if(HI)tx('RECORDE '+HI,W/2,290,9,'#ffd23a','center')}
  else if(S==='pause'){tx('PAUSA',W/2,120,24,'#fff','center');['CONTINUAR','SAIR'].forEach((s,i)=>tx((pm===i?'> ':'')+s,W/2,190+i*34,14,pm===i?'#ffd23a':'#8793b8','center'))}
  else{tx(OM,W/2,110,24,G.col,'center');tx('PONTOS '+sc,W/2,170,14,'#fff','center');tx('RECORDE '+HI,W/2,200,10,'#ffd23a','center');if(b)tx('J: JOGAR DE NOVO',W/2,260,11,'#fff','center');tx('ESC: SAIR',W/2,300,9,'#8793b8','center')}}}
const AR={x:20,y:34,w:600,h:316},WL=18,MAXW=10;
const ITEMS=[{n:'DANO +3',p:14,f:s=>s.dmg+=3},{n:'TIRO +20%',p:14,f:s=>s.rate*=.8},{n:'VIDA +4',p:12,f:s=>{s.mhp+=4;s.hp+=4}},{n:'VELOZ +10%',p:10,f:s=>s.spd*=1.1},{n:'ALCANCE +30',p:12,f:s=>s.rng+=30},{n:'IMA +25',p:8,f:s=>s.mag+=25},{n:'CURA TOTAL',p:9,f:s=>s.hp=s.mhp}];
const G={id:'brotato',title:'BROTATO',col:'#c98a4a',sub:['WASD: ANDAR (ATIRA SOZINHO)','SOBREVIVA ATE A ONDA '+MAXW,'GASTE MATERIAIS NA LOJA'],
init(){sc=0;this.s={hp:12,mhp:12,dmg:6,rate:.55,spd:100,rng:170,mag:40};this.w=1;this.mats=0;this.begin()},
begin(){this.st='wave';this.tm=WL;this.p={x:320,y:192,inv:0,fr:0,fc:1};this.e=[];this.b=[];this.m=[];this.sp=0;this.hit=[]},
update(dt){if(this.st==='shop')return;const s=this.s,p=this.p,[mx,my]=mv(),d=mx&&my?.707:1;
 p.x=clamp(p.x+mx*s.spd*dt*d,AR.x+10,AR.x+AR.w-10);p.y=clamp(p.y+my*s.spd*dt*d,AR.y+10,AR.y+AR.h-10);if(mx)p.fc=mx;p.inv-=dt;p.fr-=dt;
 this.tm-=dt;this.sp-=dt;
 if(this.sp<=0&&this.tm>1){this.sp=Math.max(.25,.9-this.w*.06);const t=Math.random(),a=Math.random()*Math.PI*2,r=360;const big=this.w>=5&&t<.12,fast=this.w>=3&&t>=.12&&t<.35;
  this.e.push({x:clamp(320+Math.cos(a)*r,AR.x,AR.x+AR.w),y:clamp(192+Math.sin(a)*r*.6,AR.y,AR.y+AR.h),hp:(big?40:9)+this.w*3,v:big?22:fast?58:36+this.w*2,sz:big?12:fast?5:7,c:big?'#7a2a8a':fast?'#e8b04a':'#4a9a3a',big:big})}
 if(p.fr<=0){let n=null,nd=s.rng;for(const e of this.e){const dd=Math.hypot(e.x-p.x,e.y-p.y);if(dd<nd){nd=dd;n=e}}if(n){p.fr=s.rate;const a=Math.atan2(n.y-p.y,n.x-p.x);this.b.push({x:p.x,y:p.y,vx:Math.cos(a)*280,vy:Math.sin(a)*280,l:s.rng/280});bp(480,.04,.02)}}
 for(const b of this.b){b.x+=b.vx*dt;b.y+=b.vy*dt;b.l-=dt}
 for(const e of this.e){const a=Math.atan2(p.y-e.y,p.x-e.x);e.x+=Math.cos(a)*e.v*dt;e.y+=Math.sin(a)*e.v*dt;
  for(const b of this.b)if(b.l>0&&Math.hypot(b.x-e.x,b.y-e.y)<e.sz+3){b.l=0;e.hp-=s.dmg;e.fl=.08;if(e.hp<=0){e.dead=1;sc+=5;bp(200,.07,.04,'sawtooth');for(let i=0;i<(e.big?4:1);i++)this.m.push({x:e.x+rnd(-6,6),y:e.y+rnd(-6,6)})}}
  if(!e.dead&&p.inv<=0&&Math.hypot(p.x-e.x,p.y-e.y)<e.sz+6){s.hp-=e.big?3:1;p.inv=.6;bp(120,.2,.07,'sawtooth');if(s.hp<=0){over('VOCE MORREU NA ONDA '+this.w);return}}e.fl-=dt}
 this.e=this.e.filter(e=>!e.dead);this.b=this.b.filter(b=>b.l>0);
 for(const q of this.m){const dd=Math.hypot(p.x-q.x,p.y-q.y);if(dd<s.mag){q.x+=(p.x-q.x)/dd*160*dt;q.y+=(p.y-q.y)/dd*160*dt}if(dd<9){q.g=1;this.mats++;sc++;bp(1000,.05,.02)}}this.m=this.m.filter(q=>!q.g);
 if(this.tm<=0){for(const q of this.m){q.g=1;this.mats++}if(this.w>=MAXW){sc+=200;over('VITORIA! VOCE SOBREVIVEU');return}this.st='shop';this.sel=0;this.cards=[];const pool=ITEMS.slice().sort(()=>Math.random()-.5).slice(0,3);this.cards=pool.map(i=>({i:i,pr:Math.round(i.p*(1+this.w*.15)),sold:0}));bp(660,.3,.05)}},
key(k){if(this.st!=='shop')return;const n=4;if(k==='a'||k==='arrowleft')this.sel=(this.sel+n-1)%n;else if(k==='d'||k==='arrowright')this.sel=(this.sel+1)%n;
 else if(k==='enter'||k===' '||k==='j'){if(this.sel===3){this.w++;this.begin();bp(700,.12,.05)}else{const c=this.cards[this.sel];if(c&&!c.sold&&this.mats>=c.pr){this.mats-=c.pr;c.sold=1;c.i.f(this.s);bp(900,.12,.05)}else bp(110,.1,.05)}}},
draw(){rc(0,0,W,H,'#1a1410');rc(AR.x-4,AR.y-4,AR.w+8,AR.h+8,'#3a2a1e');rc(AR.x,AR.y,AR.w,AR.h,'#5a7a3a');for(let y=0;y<AR.h;y+=24)for(let x=0;x<AR.w;x+=24)if((x+y)/24%2)rc(AR.x+x,AR.y+y,24,24,'#547234');
 for(const q of this.m)rc(q.x-3,q.y-3,6,6,'#7be05a');
 for(const e of this.e){rc(e.x-e.sz,e.y-e.sz,e.sz*2,e.sz*2,e.fl>0?'#fff':e.c);rc(e.x-e.sz/2-1,e.y-2,2,2,'#000');rc(e.x+e.sz/2-1,e.y-2,2,2,'#000')}
 for(const b of this.b)rc(b.x-2,b.y-2,5,5,'#fff3b0');
 const p=this.p;if(p.inv<=0||Math.floor(T*14)%2){rc(p.x-9,p.y-11,18,22,'#c98a4a');rc(p.x-7,p.y-13,14,4,'#c98a4a');rc(p.x-5,p.y-5,3,3,'#000');rc(p.x+2,p.y-5,3,3,'#000');rc(p.x-3,p.y+3,6,2,'#6b3a1a');rc(p.x+p.fc*10-2,p.y+2,5,5,'#a86a30')}
 const s=this.s;rc(16,10,130,12,'#000');rc(17,11,128*s.hp/s.mhp,10,'#d93829');tx(Math.ceil(s.hp)+'/'+s.mhp,81,17,7,'#fff','center');
 tx('ONDA '+this.w+'/'+MAXW,W/2,16,10,'#fff','center');if(this.st==='wave')tx(Math.max(0,Math.ceil(this.tm))+'S',W/2+90,16,10,'#ffd23a');
 rc(W-150,10,10,10,'#7be05a');tx(String(this.mats),W-134,16,10,'#fff');tx('PONTOS '+sc,W-16,356,7,'#8793b8','right');
 if(this.st==='shop'){rc(0,0,W,H,'rgba(10,8,6,.85)');tx('LOJA - ONDA '+this.w+' CONCLUIDA',W/2,50,14,'#ffd23a','center');tx('MATERIAIS: '+this.mats,W/2,80,10,'#7be05a','center');
  for(let i=0;i<4;i++){const x=40+i*148,on=this.sel===i,c=this.cards[i];rc(x,115,136,150,on?'#ffd23a':'#3a2a1e');rc(x+3,118,130,144,'#241a12');
   if(i===3){tx('PROXIMA',x+68,170,10,'#fff','center');tx('ONDA',x+68,190,10,'#fff','center')}else{tx(c.i.n,x+68,150,8,c.sold?'#555':'#fff','center');tx(c.sold?'COMPRADO':c.pr+' MAT.',x+68,200,9,c.sold?'#555':(this.mats>=c.pr?'#7be05a':'#d93829'),'center')}}
  tx('A / D: ESCOLHER   J: COMPRAR',W/2,320,8,'#8793b8','center')}}};

try{HI=+localStorage.getItem('hi:'+G.id)||0}catch(e){}try{document.fonts.load("10px 'Press Start 2P'")}catch(e){}
G.init();requestAnimationFrame(loop);
</script></body></html>
